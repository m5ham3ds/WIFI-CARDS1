<full-backup-content>
    <!-- Explicitly exclude sensitive state, credentials, database, and preferences -->
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="datastore/" />
    <exclude domain="file" path="secure_prefs/" />
    <exclude domain="root" path="." />
</full-backup-content>
