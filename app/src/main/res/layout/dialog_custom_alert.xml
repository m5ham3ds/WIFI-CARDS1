<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_custom_dialog"
    android:padding="22dp"
    android:gravity="center_horizontal">

    <!-- Icon Squircle Header with Glow -->
    <FrameLayout
        android:id="@+id/dialog_icon_container"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_dialog_badge_blue"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/dialog_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_info"
            android:contentDescription="Dialog Icon" />
    </FrameLayout>

    <!-- Dialog Title -->
    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/auto_string_11"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:textStyle="bold"
        android:gravity="center"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="8dp" />

    <!-- Dialog Message -->
    <TextView
        android:id="@+id/dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/auto_string_12"
        android:textColor="#94A3B8"
        android:textSize="13sp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:layout_marginBottom="20dp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#161E2E"
        android:layout_marginBottom="18dp" />

    <!-- Action Buttons Container (Side by side for modern UX) -->
    <LinearLayout
        android:id="@+id/dialog_buttons_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Negative / Cancel Button (Secondary) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_dialog_negative"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/auto_string_14"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_dialog_btn_secondary"
                app:backgroundTint="@null"
                android:layout_marginEnd="8dp"
                android:visibility="gone" />

            <!-- Positive / Confirm Button (Primary Vibrant) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_dialog_positive"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/auto_string_13"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_dialog_btn_primary"
                app:backgroundTint="@null" />

        </LinearLayout>

        <!-- Neutral Button (Optional below) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dialog_neutral"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="@string/auto_string_15"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:layout_marginTop="6dp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
