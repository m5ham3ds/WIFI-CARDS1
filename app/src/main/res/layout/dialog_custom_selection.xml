<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_custom_dialog"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <!-- Top Badge Header -->
    <FrameLayout
        android:id="@+id/dialog_selection_icon_container"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_dialog_badge_red"
        android:layout_marginBottom="12dp">

        <ImageView
            android:id="@+id/dialog_selection_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_palette"
            android:contentDescription="Selection Icon" />
    </FrameLayout>

    <!-- Dialog Title -->
    <TextView
        android:id="@+id/dialog_selection_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:textStyle="bold"
        android:gravity="center"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="16dp" />

    <!-- Options Container (Scrollable if many options) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="320dp"
        android:fadeScrollbars="false"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:id="@+id/dialog_selection_options_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:dividerPadding="8dp" />
    </ScrollView>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#161E2E"
        android:layout_marginBottom="14dp" />

    <!-- Cancel Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_dialog_selection_cancel"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="@string/btn_cancel"
        android:textColor="#94A3B8"
        android:textSize="13sp"
        android:textStyle="bold"
        android:background="@drawable/bg_dialog_btn_secondary"
        app:backgroundTint="@null" />

</LinearLayout>
